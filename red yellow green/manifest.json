{
  "manifest_version": 3,
  "name": "Artis CRM Check",
  "version": "1.1.0",
  "description": "Red / yellow / green HubSpot status for the website or Instagram profile you're on, and every email on the page.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.hubapi.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Artis CRM Check",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
